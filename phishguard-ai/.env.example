# ============================================================
# PhishGuard AI — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
DEBUG=false
LOG_LEVEL=INFO

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=["http://localhost:3001","http://localhost:3000","http://localhost:80"]

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=PhishGuard AI
NEXT_PUBLIC_APP_VERSION=1.0.0

# --- PostgreSQL ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=phishguard
POSTGRES_USER=phishguard
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://phishguard:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/phishguard

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/2

# --- JWT ---
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=25
UPLOAD_TEMP_DIR=/tmp/phishguard_uploads

# --- AI Provider ---
# Set AI_PROVIDER to: openai | google | mock
# mock works without any API key (clearly labeled demo data)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# --- Threat Intelligence (all optional) ---
# Set DEMO_MODE=true to use mock providers without real API keys
TI_DEMO_MODE=true

VIRUSTOTAL_API_KEY=
VIRUSTOTAL_ENABLED=false

URLHAUS_ENABLED=true
URLHAUS_BASE_URL=https://urlhaus-api.abuse.ch/v1

ABUSEIPDB_API_KEY=
ABUSEIPDB_ENABLED=false

# --- Email (for password reset, optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@phishguard.local
SMTP_USE_TLS=true

# --- Security ---
BCRYPT_ROUNDS=12
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
RATE_LIMIT_PER_MINUTE=60

# --- Encryption (for API keys at rest) ---
ENCRYPTION_KEY=CHANGE_ME_TO_A_32_BYTE_BASE64_ENCODED_KEY
